{
  "manifest_version": 3,
  "name": "Browser Automation Core Demo",
  "version": "0.3.1",
  "description": "Standalone Native Messaging feasibility demo. No arbitrary eval.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms", "tabs", "scripting", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Browser Core connection status", "default_popup": "status.html"}
}
