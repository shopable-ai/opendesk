{
  "schemaVersion": 1,
  "actions": {
    "home": {
      "visible": true,
      "url": "https://github.com/shopable-ai/opendesk#home"
    },
    "help": {
      "visible": true,
      "url": "https://github.com/shopable-ai/opendesk#help"
    },
    "examples": {
      "visible": true,
      "url": "https://github.com/shopable-ai/opendesk/tree/master/examples"
    },
    "apiDocs": {
      "visible": true,
      "url": "https://github.com/shopable-ai/opendesk/blob/master/docs/api/index.md"
    },
    "customize": {
      "visible": true,
      "url": "https://github.com/shopable-ai/opendesk#customize"
    },
    "marketplace": {
      "visible": false,
      "url": "https://github.com/shopable-ai/opendesk#marketplace"
    },
    "upgrade": {
      "visible": false,
      "url": "https://github.com/shopable-ai/opendesk#upgrade"
    }
  },
  "analytics": {
    "provider": "posthog",
    "endpoint": "https://us.i.posthog.com",
    "projectToken": "",
    "environment": "production",
    "maxEventBytes": 2048,
    "queue": {
      "maxEvents": 1000,
      "batchSize": 20,
      "maxRequests": 4
    },
    "network": {
      "requestTimeoutMs": 3000,
      "flushIntervalMs": 5000,
      "maxRetries": 1,
      "shutdownTimeoutMs": 750
    },
    "session": {
      "idleTimeoutMinutes": 30
    }
  }
}
