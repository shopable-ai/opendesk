{
  "schemaVersion": 1,
  "id": "com.opendesk.desktop",
  "name": "OpenDesk",
  "version": "2.0.1",
  "entry": "main.js",
  "singleInstance": true,
  "window": {
    "mainId": "main",
    "closeBehavior": "hide"
  },
  "tray": {
    "enabled": true,
    "tooltip": "OpenDesk",
    "primaryAction": "opendesk.open",
    "icons": {
      "windows": "assets/tray.ico",
      "macos": "assets/opendesk-logo.png"
    },
    "menu": [
      {
        "id": "open-ai-assistant",
        "labelKey": "menu.assistant",
        "label": "AI 助手",
        "action": "assistant.open"
      },
      {
        "type": "separator"
      },
      {
        "id": "open-scheduler-center",
        "labelKey": "menu.schedulerCenter",
        "label": "计划中心",
        "action": "scheduler.center"
      },
      {
        "id": "new-schedule",
        "labelKey": "menu.newSchedule",
        "label": "新建计划…",
        "action": "scheduler.new"
      },
      {
        "type": "separator"
      },
      {
        "id": "open-permissions",
        "labelKey": "menu.permissions",
        "label": "系统权限",
        "action": "permissions.open"
      },
      {
        "id": "open-analytics-settings",
        "label": "基础使用统计…",
        "action": "analytics.open"
      },
      {
        "id": "open-runtime-log",
        "labelKey": "menu.runtimeLog",
        "label": "运行日志",
        "action": "runtime.log"
      },
      {
        "id": "restore-promotions",
        "label": "恢复推广",
        "action": "promotions.restore",
        "visible": false
      },
      {
        "type": "separator"
      },
      {
        "id": "open-examples",
        "labelKey": "menu.examples",
        "label": "示例代码",
        "action": "opendesk.examples"
      },
      {
        "id": "open-api-docs",
        "labelKey": "menu.apiDocs",
        "label": "API 文档",
        "action": "opendesk.api-docs"
      }
    ]
  }
}
