{
  "schemaVersion": 1,
  "id": "com.opendesk.desktop",
  "version": "0.1.0",
  "name": "OpenDesk",
  "runtime": {
    "minVersion": "0.1.0"
  },
  "entry": "main.js",
  "singleInstance": true,
  "window": {
    "mainId": "main",
    "closeBehavior": "hide"
  },
  "tray": {
    "enabled": true,
    "icons": {
      "windows": "assets/tray.ico",
      "macos": "assets/tray-template.png"
    },
    "tooltip": "OpenDesk",
    "primaryAction": "opendesk.open",
    "menuMode": "merge",
    "menu": [
      { "id": "runner.open", "label": "打开 Script Runner", "action": "runner.open" }
    ]
  }
}
