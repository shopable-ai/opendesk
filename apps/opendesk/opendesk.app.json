{
  "schemaVersion": 1,
  "id": "com.opendesk.desktop",
  "name": "OpenDesk",
  "version": "0.1.0",
  "entry": "main.js",
  "singleInstance": true,
  "window": {
    "mainId": "main",
    "closeBehavior": "hide"
  },
  "tray": {
    "enabled": true,
    "tooltip": "OpenDesk",
    "primaryAction": "opendesk.open",
    "icons": {
      "windows": "assets/tray.ico",
      "macos": "assets/tray-template.png"
    },
    "menu": [
      {
        "id": "open-opendesk",
        "label": "打开 OpenDesk",
        "action": "runner.open"
      },
      {
        "type": "separator"
      },
      {
        "id": "open-scheduler-center",
        "label": "计划中心",
        "action": "scheduler.center"
      },
      {
        "id": "new-schedule",
        "label": "新建计划…",
        "action": "scheduler.new"
      },
      {
        "type": "separator"
      },
      {
        "id": "open-inspector",
        "label": "Inspector",
        "action": "inspector.open"
      },
      {
        "id": "open-permissions",
        "label": "权限管理…",
        "action": "permissions.open"
      },
      {
        "id": "open-runtime-log",
        "label": "运行日志…",
        "action": "runtime.log"
      }
    ]
  }
}
