{
  "schemaVersion": 1,
  "id": "com.opendesk.desktop",
  "name": "OpenDesk",
  "version": "0.1.0",
  "entry": "main.js",
  "window": {
    "singleInstance": true,
    "mainId": "main",
    "closeBehavior": "hide"
  },
  "permissions": {
    "recorder": true
  },
  "tray": {
    "enabled": true,
    "tooltip": "OpenDesk",
    "menu": [
      {
        "id": "open-opendesk",
        "type": "item",
        "label": "打开 OpenDesk",
        "action": "runner.open"
      },
      {
        "id": "separator-runner-scheduler",
        "type": "separator"
      },
      {
        "id": "open-scheduler-center",
        "type": "item",
        "label": "计划中心",
        "action": "scheduler.center"
      },
      {
        "id": "new-schedule",
        "type": "item",
        "label": "新建计划…",
        "action": "scheduler.new"
      },
      {
        "id": "open-runtime-log",
        "type": "item",
        "label": "运行日志…",
        "action": "runtime.log"
      }
    ]
  }
}
