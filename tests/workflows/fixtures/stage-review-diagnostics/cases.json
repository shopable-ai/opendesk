        "comparator": "equal",
        "attribution": "output-preservation",
        "nextRepair": "保留同版 S6；只修正 S7 输出中丢失的 firstResult 消费者关系，重新执行该边界检查；受影响 S8 以后不能继续消费旧 S7。此结论不要求重做真实示范。",
        "nextEvidence": "先取得并核对同版输入前提、输出正文及对应必需测试；若输入或证据缺失，不把本阶段命名为已证明修复责任。"
      },
      "context": [
        {
          "label": "上游实际声明的生产者",
          "selector": {
            "collection": "inputs",
            "kind": "DemonstrationDossier",
            "pointer": "/firstResult/producer"
          }
        }
      ],
      "expectedBoundary": "S7",
      "expectedOwner": "S7"
    },
