  "steps": [
    {
      "stepId": "grant-accessibility",
      "action": "grant_accessibility",
      "target": "system.permissions.accessibility",
      "expectedVerifiers": ["ui_observable"],
      "mockOutcome": "blocked",
      "mockFailureClass": "permission_blocked"
    }
  ]
}
