{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendesk.dev/schemas/flow/flow.schema.json",
  "title": "OpenDesk Flow Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "flowId",
    "name",
    "version",
    "publisherId",
    "publisherKeyId",
    "entry",
    "minimumRuntimeVersion",
    "platforms",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "flowId": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "$ref": "#/$defs/semver" },
    "publisherId": { "$ref": "#/$defs/id" },
    "publisherKeyId": { "$ref": "#/$defs/id" },
    "entry": { "enum": ["main.js", "main.odpkg"] },
    "minimumRuntimeVersion": { "$ref": "#/$defs/semver" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["darwin", "linux", "windows"] }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/file" }
    },
    "commercial": { "$ref": "#/$defs/commercial" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._@+-]{0,127}(?:/[A-Za-z0-9_][A-Za-z0-9._@+-]{0,127})*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0, "maximum": 33554432 }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "licenseIssuerKeyId", "purposes"],
      "properties": {
        "productId": { "$ref": "#/$defs/id" },
        "licenseIssuerKeyId": { "$ref": "#/$defs/id" },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "run" }
        }
      }
    }
  }
}
