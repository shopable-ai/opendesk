{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendesk.local/schemas/recorder/flow-v0.1.schema.json",
  "title": "OpenDesk deterministic Flow IR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "flowId", "sessionId", "goal", "mode", "createdAt", "steps"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "flowId": {"type": "string", "minLength": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "mode": {"const": "deterministic"},
    "createdAt": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stepId", "sourceActionIds", "intent", "target", "action", "verification", "risk"],
        "properties": {
          "stepId": {"type": "string", "minLength": 1},
          "sourceActionIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "intent": {"type": "string", "minLength": 1},
          "target": {"type": "string"},
          "locatorCandidates": {"type": ["array", "null"]},
          "preconditions": {"type": ["array", "null"]},
          "action": {"type": "object", "required": ["name"]},
          "expectedPostconditions": {"type": ["array", "null"]},
          "verification": {"type": "object", "required": ["status"]},
          "fallbacks": {"type": "array"},
          "risk": {"type": "string"}
        }
      }
    }
  }
}
