{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendesk.dev/schemas/runtime-api/runtime-api-evidence-manifest.schema.json",
  "title": "OpenDesk Runtime API Evidence Manifest",
  "type": "object",
  "required": ["schemaVersion", "runId", "kind", "window", "viewport", "screenshots", "eventArtifacts", "statePath"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "window": { "type": "object" },
    "viewport": { "type": "object" },
    "screenshots": {
      "type": "object",
      "required": ["pre", "post"]
    },
    "eventArtifacts": { "type": "array", "minItems": 2 },
    "statePath": { "type": "string" }
  }
}
