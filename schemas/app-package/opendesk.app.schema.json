{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendesk.dev/schemas/app-package/opendesk.app.schema.json",
  "title": "OpenDesk App Package Manifest V1",
  "description": "Authoring schema for schemaVersion 1 App Mode packages. The OpenDesk Runtime loader remains the authoritative validator for semantics, compatibility, resources, containment, and additive menu presentation references such as labelKey.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "entry",
    "window"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^\\s*[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+\\s*$",
      "description": "Stable lowercase reverse-DNS package identity. The Runtime additionally enforces a 63-byte maximum per segment after trimming."
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minVersion": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "entry": {
      "allOf": [
        {
          "$ref": "#/$defs/packageRelativePath"
        }
      ]
    },
    "singleInstance": {
      "type": "boolean",
      "default": true
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mainId"
      ],
      "properties": {
        "mainId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^\\s*[A-Za-z][A-Za-z0-9_-]{0,63}\\s*$"
        },
        "closeBehavior": {
          "enum": [
            "hide",
            "quit"
          ],
          "default": "quit"
        }
      }
    },
    "tray": {
      "$ref": "#/$defs/tray"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\s*[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\s*$"
      },
      "description": "Declaration metadata only; this does not grant permissions or establish a sandbox."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "window": {
            "properties": {
              "closeBehavior": {
                "const": "hide"
              }
            },
            "required": [
              "closeBehavior"
            ]
          }
        },
        "required": [
          "window"
        ]
      },
      "then": {
        "properties": {
          "tray": {
            "properties": {
              "enabled": {
                "const": true
              },
              "primaryAction": {
                "const": "opendesk.open"
              }
            },
            "required": [
              "enabled",
              "primaryAction"
            ]
          }
        },
        "required": [
          "tray"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "com.opendesk.desktop"
          }
        },
        "required": [
          "id"
        ]
      },
      "else": {
        "properties": {
          "tray": {
            "properties": {
              "menu": {
                "items": {
                  "$ref": "#/$defs/thirdPartyMenuItem"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\s*(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?\\s*$"
    },
    "packageRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*(?:/|\\\\|[A-Za-z]:|\\.\\.(?:[/\\\\]|\\s*$)))(?!.*\\u0000).*\\S.*$",
      "description": "Portable package-relative path. The Runtime performs canonical real-path and symlink containment checks."
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\s*[A-Za-z0-9][A-Za-z0-9._-]*\\s*$"
    },
    "localizationKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\s*[A-Za-z0-9][A-Za-z0-9._-]*\\s*$"
    },
    "businessActionId": {
      "allOf": [
        {
          "$ref": "#/$defs/actionId"
        },
        {
          "pattern": "^\\s*(?![oO][pP][eE][nN][dD][eE][sS][kK]\\.)"
        }
      ]
    },
    "productResourceActionId": {
      "oneOf": [
        {
          "$ref": "#/$defs/businessActionId"
        },
        {
          "const": "opendesk.examples"
        },
        {
          "const": "opendesk.api-docs"
        }
      ]
    },
    "tray": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windows": {
              "allOf": [
                {
                  "$ref": "#/$defs/packageRelativePath"
                },
                {
                  "pattern": "\\.[iI][cC][oO]\\s*$"
                }
              ]
            },
            "macos": {
              "allOf": [
                {
                  "$ref": "#/$defs/packageRelativePath"
                },
                {
                  "pattern": "\\.[pP][nN][gG]\\s*$"
                }
              ]
            }
          }
        },
        "tooltip": {
          "type": "string"
        },
        "primaryAction": {
          "oneOf": [
            {
              "const": "opendesk.open"
            },
            {
              "$ref": "#/$defs/businessActionId"
            }
          ]
        },
        "menuMode": {
          "const": "merge",
          "default": "merge"
        },
        "menu": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/menuItem"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "icons",
              "primaryAction"
            ],
            "properties": {
              "icons": {
                "required": [
                  "windows",
                  "macos"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "icons": {
                "maxProperties": 0
              },
              "tooltip": {
                "const": ""
              },
              "primaryAction": {
                "const": ""
              },
              "menu": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "menuItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "separator"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "type": {
              "const": ""
            },
            "id": {
              "$ref": "#/$defs/businessActionId"
            },
            "labelKey": {
              "$ref": "#/$defs/localizationKey"
            },
            "label": {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            "action": {
              "oneOf": [
                {
                  "pattern": "^\\s*$"
                },
                {
                  "$ref": "#/$defs/productResourceActionId"
                }
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "anyOf": [
            {
              "required": [
                "label"
              ]
            },
            {
              "required": [
                "labelKey"
              ]
            }
          ],
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "action"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "action": {
                        "pattern": "^\\s*$"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  }
                ]
              },
              "then": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "thirdPartyMenuItem": {
      "allOf": [
        {
          "$ref": "#/$defs/menuItem"
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "oneOf": [
                {
                  "pattern": "^\\s*$"
                },
                {
                  "$ref": "#/$defs/businessActionId"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
